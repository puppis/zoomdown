[
  // On macOS the Command key variants: Sublime Text resolves ctrl+alt+<letter> through the
  // character that Option+<letter> types, which on most non-US layouts is not the letter, so
  // Control+Option combinations may never match. ⌘⌥ combinations are read as the plain letter.
  { "keys": ["super+alt+b"], "command": "zoomdown_run", "args": { "task": "preview" },
    "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown.zoomdown" }] },
  { "keys": ["super+alt+j"], "command": "zoomdown_jump",
    "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown.zoomdown" }] },
  { "keys": ["super+alt+p"], "command": "zoomdown_run", "args": { "task": "build" },
    "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown.zoomdown" }] },
  // In a deck the build keys export it too, but without Sublime Text's build, which saves the open files.
  { "keys": ["super+b"], "command": "zoomdown_run", "args": { "task": "build" },
    "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown.zoomdown" }] },
  { "keys": ["f7"], "command": "zoomdown_run", "args": { "task": "build" },
    "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown.zoomdown" }] }
]
